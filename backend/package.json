{
  "name": "gymhelper-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:migrate": "npm run build && node dist/infrastructure/database/migrate.js",
    "db:import-exercises": "npm run build && node dist/infrastructure/database/import-exercises.js",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "express-session": "1.19.0",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@types/express-session": "1.19.0",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  }
}
