# Copiar este archivo a .env y completar los valores vacíos. No subir .env a Git.

# Contraseña administrativa de MySQL.
MYSQL_ROOT_PASSWORD=

MYSQL_DATABASE=gymhelper
MYSQL_USER=gymhelper_app
# Debe ser distinta de MYSQL_ROOT_PASSWORD.
MYSQL_PASSWORD=

# Valor aleatorio de al menos 32 caracteres. Conservarlo entre reinicios.
SECRETO_DE_SESION=

# Cuenta de administrador de prueba, solo para desarrollo local.
ADMIN_INICIAL_CORREO=admin@example.test
ADMIN_INICIAL_CONTRASENA=Admin1234

# Remitente de los correos de recuperación de contraseña (opcional). En desarrollo los recibe Mailpit.
# CORREO_REMITENTE=GymHelper <no-responder@gymhelper.local>

# Origen del frontend autorizado por el backend (CORS y operaciones que modifican datos). También es la base de los enlaces de recuperación de contraseña.
ORIGEN_DEL_FRONTEND=http://127.0.0.1:5173
